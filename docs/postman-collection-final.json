					"raw": "{\n  \"parameterId\": \"{{wbcId}}\",\n  \"subCategoryId\": null,\n  \"gender\": \"BOTH\",\n  \"ageFrom\": 18,\n  \"ageTo\": null,\n  \"ageType\": \"year\",\n  \"minValue\": 4000,\n  \"maxValue\": 11000,\n  \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/parameter/defaultParameter/add",
