		{
			"name": "6. Add Hemoglobin Range - Male Adult",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"parameterId\": \"{{hemoglobinId}}\",\n  \"subCategoryId\": \"{{hbMaleSubcategoryId}}\",\n  \"gender\": \"MALE\",\n  \"ageFrom\": 18,\n  \"ageTo\": 65,\n  \"ageType\": \"year\",\n  \"minValue\": 13.5,\n  \"maxValue\": 17.5,\n  \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/parameter/defaultParameter/add",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"parameter",
						"defaultParameter",
						"add"
					]
				},
				"description": "Add normal range for hemoglobin in adult males"
			},
			"response": []
		},
		{
			"name": "7. Add WBC Range - Adult Both",
			"request": {
