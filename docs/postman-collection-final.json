{
	"info": {
		"_postman_id": "queueless-lab-api-final",
		"name": "Queueless Lab API - Final Flow with Range Validation",
		"description": "Final API flow with parameter ranges and validation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Lab Signup",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"labName\": \"City Diagnostic Center\",\n  \"ownerName\": \"John Smith\",\n  \"mobileNumber\": \"+1234567890\",\n  \"labMobileNumber\": \"+0987654321\",\n  \"email\": \"city@diagnostic.com\",\n  \"password\": \"securePassword123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/signup",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"signup"
					]
				},
				"description": "Register a new lab in the system"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data.token) {",
							"        pm.environment.set(\"token\", response.data.token);",
							"        pm.environment.set(\"labId\", response.data.user.id);",
							"        console.log('Token saved:', response.data.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
		{
			"name": "2. Lab Login",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"labMobileNumber\": \"+0987654321\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"login"
					]
				},
				"description": "Login with lab mobile number to get authentication token"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data.token) {",
							"        pm.environment.set(\"token\", response.data.token);",
							"        pm.environment.set(\"labId\", response.data.user.id);",
							"        console.log('Token saved:', response.data.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
		{
			"name": "3. Add Hemoglobin Parameter",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"code\": \"HB\",\n  \"name\": \"Hemoglobin\",\n  \"category\": \"CBC\",\n  \"type\": \"NUMERIC\",\n  \"unit\": \"g/dL\",\n  \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/parameter/add",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"parameter",
						"add"
					]
				},
				"description": "Add Hemoglobin parameter"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data._id) {",
							"        pm.environment.set(\"hemoglobinId\", response.data._id);",
							"        console.log('Hemoglobin ID saved:', response.data._id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
