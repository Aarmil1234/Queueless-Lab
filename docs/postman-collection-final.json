		{
			"name": "8. Add Patient",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"patientName\": \"John Doe\",\n  \"gender\": \"Male\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"age\": 34,\n  \"ageType\": \"year\",\n  \"referredByDoctor\": \"Dr. Smith\",\n  \"doctorContactNo\": \"+1234567890\",\n  \"address\": \"456 Oak Avenue\",\n  \"city\": \"New York\",\n  \"mobileNumber\": \"+0987654321\",\n  \"tests\": [\n    \"Complete Blood Count\"\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/patient",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"patient"
					]
				},
				"description": "Register a new patient"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const response = pm.response.json();",
							"    console.log('Patient created:', response);",
							"    // You may need to manually set patientId from response",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
		{
			"name": "9. Create Report",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"labId\": \"{{labId}}\",\n  \"tests\": [\n    {\n      \"testName\": \"Complete Blood Count\",\n      \"testId\": null\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/report/create",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"report",
						"create"
					]
				},
				"description": "Create a new report for patient (without predefined test)"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data._id) {",
							"        pm.environment.set(\"reportId\", response.data._id);",
							"        // Also save the test entry ID for adding results",
							"        if (response.data.testReport && response.data.testReport[0]) {",
							"            pm.environment.set(\"testEntryId\", response.data.testReport[0]._id);",
							"        }",
							"        console.log('Report ID saved:', response.data._id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
		{
			"name": "10. Add Report Results - Normal Range (Should Pass)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"reportId\": \"{{reportId}}\",\n  \"testId\": \"{{testEntryId}}\",\n  \"labId\": \"{{labId}}\",\n  \"testParameters\": [\n    {\n      \"parameterId\": \"{{hemoglobinId}}\",\n      \"subCategoryId\": \"{{hbMaleSubcategoryId}}\",\n      \"value\": \"15.0\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Within normal range\"\n    },\n    {\n      \"parameterId\": \"{{wbcId}}\",\n      \"subCategoryId\": null,\n      \"value\": \"7500\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Normal white blood cell count\"\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/report/testWise",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"report",
						"testWise"
					]
				},
				"description": "Add test results with normal values (should pass validation)"
			},
			"response": []
		},
		{
			"name": "11. Add Report Results - Abnormal Range (Should Show Warnings)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"reportId\": \"{{reportId}}\",\n  \"testId\": \"{{testEntryId}}\",\n  \"labId\": \"{{labId}}\",\n  \"testParameters\": [\n    {\n      \"parameterId\": \"{{hemoglobinId}}\",\n      \"subCategoryId\": \"{{hbMaleSubcategoryId}}\",\n      \"value\": \"12.0\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Below normal range\"\n    },\n    {\n      \"parameterId\": \"{{wbcId}}\",\n      \"subCategoryId\": null,\n      \"value\": \"15000\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Above normal range\"\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/report/testWise",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"report",
						"testWise"
					]
				},
				"description": "Add test results with abnormal values (should show warnings but still pass)"
			},
			"response": []
		},
		{
			"name": "12. Add Report Results - Critical Range (Should Fail)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"reportId\": \"{{reportId}}\",\n  \"testId\": \"{{testEntryId}}\",\n  \"labId\": \"{{labId}}\",\n  \"testParameters\": [\n    {\n      \"parameterId\": \"{{hemoglobinId}}\",\n      \"subCategoryId\": \"{{hbMaleSubcategoryId}}\",\n      \"value\": \"8.0\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Critically low\"\n    },\n    {\n      \"parameterId\": \"{{wbcId}}\",\n      \"subCategoryId\": null,\n      \"value\": \"25000\",\n      \"status\": \"PENDING\",\n      \"notes\": \"Critically high\"\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/report/testWise",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"report",
						"testWise"
					]
				},
				"description": "Add test results with critical values (should fail validation)"
			},
			"response": []
		},
