				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"parameterId\": \"{{hemoglobinId}}\",\n  \"code\": \"HB_MALE\",\n  \"name\": \"Hemoglobin Male Range\",\n  \"isActive\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/parameter/subCategory/add",
