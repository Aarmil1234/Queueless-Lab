				"body": {
					"mode": "raw",
					"raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"labId\": \"{{labId}}\",\n  \"tests\": [\n    {\n      \"testName\": \"Complete Blood Count\",\n      \"testId\": \"{{testId}}\"\n    }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/report/create",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"report",
						"create"
					]
				},
				"description": "Create a new report for patient"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data._id) {",
							"        pm.environment.set(\"reportId\", response.data._id);",
							"        // Also save the test entry ID for adding results",
							"        if (response.data.testReport && response.data.testReport[0]) {",
							"            pm.environment.set(\"testEntryId\", response.data.testReport[0]._id);",
							"        }",
							"        console.log('Report ID saved:', response.data._id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
