		{
			"name": "1. Lab Signup",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"labName\": \"City Diagnostic Center\",\n  \"ownerName\": \"John Smith\",\n  \"mobileNumber\": \"+1234567890\",\n  \"labMobileNumber\": \"+0987654321\",\n  \"email\": \"city@diagnostic.com\",\n  \"password\": \"securePassword123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/signup",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"signup"
					]
				},
				"description": "Register a new lab in the system"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    if (response.data && response.data.token) {",
							"        pm.environment.set(\"token\", response.data.token);",
							"        pm.environment.set(\"labId\", response.data.user.id);",
							"        console.log('Token saved:', response.data.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": []
		},
