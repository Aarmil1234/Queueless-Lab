				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"code\": \"HB\",\n  \"name\": \"Hemoglobin\",\n  \"category\": \"CBC\",\n  \"type\": \"NUMERIC\",\n  \"unit\": \"g/dL\",\n  \"isActive\": true\n}"
